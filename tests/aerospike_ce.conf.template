service {
    proto-fd-max 15000
    cluster-name adk-test
}

logging {
    console {
        context any info
    }
}

network {
    service {
        address any
        port 3000
        access-address 127.0.0.1
        access-port __ACCESS_PORT__
    }
    heartbeat {
        mode mesh
        port 3002
        interval 150
        timeout 10
    }
    fabric {
        port 3001
    }
    info {
        port 3003
    }
}

namespace test {
    replication-factor 1
    storage-engine memory {
        data-size 4G
    }
    nsup-period 60
    stop-writes-sys-memory-pct 95
}
